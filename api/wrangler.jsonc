{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "queria-geocoder",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "account_id": "57c6a116efc637fc3f21d0affea15508",
  // 試作の間は workers.dev で測る。出すときに route を決める
  "workers_dev": true,
  "preview_urls": false,
  // 上流の表 (src/transform/special_chars.tsv) を文字列として読み込む
  "rules": [{ "type": "Text", "globs": ["**/*.tsv"], "fallthrough": true }],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "queria-assets" },
    // data.queria.io の中身。geocoder の表 (town・city・pref) を読む
    { "binding": "DATA", "bucket_name": "queria" },
  ],
  "vars": {
    "BOUNDARY_TILES_FILE": "boundaries-20261027.pmtiles",
    // geocoder の表の Parquet。FDL の refs/heads/main から引くまでの仮置きで、作り直したら書き換える
    "TOWN_PARQUET": "78d98fba-a18d-44e1-b572-6346196f97fb/ducklake.duckdb.files/main/town__dbt_tmp/ducklake-01a194af-a665-7afe-a696-55dd0ef106ea.parquet",
    "CITY_PARQUET": "78d98fba-a18d-44e1-b572-6346196f97fb/ducklake.duckdb.files/main/city__dbt_tmp/ducklake-01a194ac-9dd7-7409-a4a7-6d5c4d861e39.parquet",
    "PREF_PARQUET": "78d98fba-a18d-44e1-b572-6346196f97fb/ducklake.duckdb.files/main/pref__dbt_tmp/ducklake-01a194ac-a1be-7d71-b4f5-57e2f24d286e.parquet",
    "RSDTDSP_PARQUET": "",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
