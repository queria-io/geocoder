{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "queria-geocoder",
  "main": "src/index.ts",
  // アイコンと共有画像 (site/brand を pnpm build:web で public/ に置く)。/v1・/docs・/openapi.json は Worker が返す
  "assets": { "directory": "./public" },
  "compatibility_date": "2025-12-01",
  "account_id": "57c6a116efc637fc3f21d0affea15508",
  // 無料のベータとして geocoder.queria.io で出す。workers.dev は計測用に残す
  "workers_dev": true,
  "routes": [{ "pattern": "geocoder.queria.io", "custom_domain": true }],
  "preview_urls": true,
  // 上流の表 (src/transform/special_chars.tsv) を文字列として読み込む
  "rules": [{ "type": "Text", "globs": ["**/*.tsv"], "fallthrough": true }],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "queria-assets" },
    // data.queria.io の中身。geocoder の表 (town・city・pref) を読む
    { "binding": "DATA", "bucket_name": "queria" },
  ],
  "vars": {
    "BOUNDARY_TILES_FILE": "boundaries-20261027.pmtiles",
    // geocoder の表の Parquet。FDL の refs/heads/main から引くまでの仮置きで、作り直したら書き換える
    "TOWN_PARQUET": "78d98fba-a18d-44e1-b572-6346196f97fb/ducklake.duckdb.files/town/town__dbt_tmp/ducklake-01a196c3-2d45-7392-80f7-425308db3f4b.parquet",
    "CITY_PARQUET": "78d98fba-a18d-44e1-b572-6346196f97fb/ducklake.duckdb.files/main/city__dbt_tmp/ducklake-01a196b1-cf62-7f9d-9033-898af51fca5c.parquet",
    "PREF_PARQUET": "78d98fba-a18d-44e1-b572-6346196f97fb/ducklake.duckdb.files/main/pref__dbt_tmp/ducklake-01a196b9-06ef-7c14-a77e-3df32ba5e40d.parquet",
    "RSDTDSP_PARQUET": "78d98fba-a18d-44e1-b572-6346196f97fb/ducklake.duckdb.files/main/rsdtdsp__dbt_tmp/ducklake-01a196b9-c442-71d4-953a-b1cbeba81c18.parquet",
    "PARCEL_PARQUET": "78d98fba-a18d-44e1-b572-6346196f97fb/ducklake.duckdb.files/main/parcel__dbt_tmp/ducklake-01a196b7-9b6f-7c06-af6c-5fb959fac2cf.parquet,78d98fba-a18d-44e1-b572-6346196f97fb/ducklake.duckdb.files/main/parcel__dbt_tmp/ducklake-01a196b7-ddcb-7b30-8358-12122c5b7d66.parquet,78d98fba-a18d-44e1-b572-6346196f97fb/ducklake.duckdb.files/main/parcel__dbt_tmp/ducklake-01a196b8-7762-7958-a601-add3bed3d525.parquet,78d98fba-a18d-44e1-b572-6346196f97fb/ducklake.duckdb.files/main/parcel__dbt_tmp/ducklake-01a196b8-daf4-758c-bd5a-b38bcb3abb4b.parquet",
    "ISJ_PARQUET": "78d98fba-a18d-44e1-b572-6346196f97fb/ducklake.duckdb.files/main/isj_block__dbt_tmp/ducklake-01a196b2-cba5-7c85-aed8-1eedcc9ce0ef.parquet",
    // 上の表の FDL のバージョン (refs/heads/main の先頭 8 文字)。表を作り直したら書き換える
    // PARCEL_PARQUET は DuckLake が分けて書いたファイルをカンマで並べる
    "DATA_VERSION": "geocoder-20261101-01a196c3",
  },
  // IP ごとの回数の上限 (src/index.ts)。費用を守るためのもので、ふつうの使い方では当たらない高さ
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
