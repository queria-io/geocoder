{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "queria-geocoder",
  "main": "src/index.ts",
  // アイコンと共有画像 (site/brand を pnpm build:web で public/ に置く)。/v1・/docs・/openapi.json は Worker が返す
  "assets": { "directory": "./public" },
  "compatibility_date": "2025-12-01",
  "account_id": "57c6a116efc637fc3f21d0affea15508",
  // 無料のベータとして geocoder.queria.io で出す。workers.dev は計測用に残す
  "workers_dev": true,
  "routes": [{ "pattern": "geocoder.queria.io", "custom_domain": true }],
  "preview_urls": true,
  // 上流の表 (src/transform/special_chars.tsv) を文字列として読み込む
  "rules": [{ "type": "Text", "globs": ["**/*.tsv"], "fallthrough": true }],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "queria-assets" },
    // data.queria.io の中身。geocoder の表 (town・city・pref) を読む
    { "binding": "DATA", "bucket_name": "queria" },
  ],
  "vars": {
    "BOUNDARY_TILES_FILE": "boundaries-20261027.pmtiles",
    // geocoder の表の置き場 (FDL のリポジトリ)。refs/heads/main が指すバージョンを読む (src/data/source.ts)
    "DATA_SOURCE": "78d98fba-a18d-44e1-b572-6346196f97fb/",
    // バージョンを固定するときだけ ID を書く。空なら refs/heads/main に従う
    "DATA_PIN": "",
  },
  // IP ごとの回数の上限 (src/index.ts)。費用を守るためのもので、ふつうの使い方では当たらない高さ
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
  ],
  // 照合しきれなかった住所 (IP アドレスは書かない)。どんな書き方の住所が照合できないかを集める (src/misses.ts)
  "analytics_engine_datasets": [{ "binding": "MISSES", "dataset": "geocoder_misses" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
