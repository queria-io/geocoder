// 精度チェック用の設定。本番の設定 (wrangler.jsonc) から、正引きに要るものだけを残す
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "queria-geocoder-local",
  "main": "worker.ts",
  "compatibility_date": "2025-12-01",
  "rules": [{ "type": "Text", "globs": ["**/*.tsv"], "fallthrough": true }],
  "vars": {
    // serve.ts が返すフォルダの直下を FDL のリポジトリとして読む (scripts/local-version.py が書く)
    "DATA_SOURCE": "",
    "DATA_PIN": "",
    "LOCAL_DATA": "http://127.0.0.1:8788/",
  },
}
